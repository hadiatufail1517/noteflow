# NoteMind Backend Environment Config Example

# Port for backend Express server
PORT=5000

# JSON Web Token sign secret (Use a strong long random string)
AUTH_SECRET=your_jwt_signing_secret_here

# Google Gemini API key (Mandatory for AI features)
# Get yours from Google AI Studio: https://aistudio.google.com/
LLM_API_KEY=your_gemini_api_key_here

# Production Database URL (Optional: Defaults to SQLite local database file if omitted)
# Example: postgres://user:password@hostname:5432/dbname
DATABASE_URL=
